{
    "title": "Heart Risk API",
    "uid": "heart-risk-api",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "10s",
    "time": {"from": "now-15m", "to": "now"},
    "panels": [
      {
        "id": 1, "type": "stat", "title": "API pods up",
        "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [{"refId": "A", "expr": "count(up{job=\"heart-risk-api\"} == 1)"}]
      },
      {
        "id": 2, "type": "stat", "title": "Predictions served",
        "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [{"refId": "A", "expr": "sum(model_predictions_total)"}]
      },
      {
        "id": 3, "type": "timeseries", "title": "Requests per second by endpoint",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [{"refId": "A", "expr": "sum by (endpoint) (rate(api_requests_total[1m]))", "legendFormat": "{{endpoint}}"}]
      },
      {
        "id": 4, "type": "timeseries", "title": "p95 latency of /predict (seconds)",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_latency_seconds_bucket{endpoint=\"/predict\"}[5m])))"}]
      },
      {
        "id": 5, "type": "timeseries", "title": "Responses by status code",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [{"refId": "A", "expr": "sum by (status) (rate(api_requests_total[1m]))", "legendFormat": "{{status}}"}]
      },
      {
        "id": 6, "type": "timeseries", "title": "Predictions by outcome",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [{"refId": "A", "expr": "sum by (label) (rate(model_predictions_total[1m]))", "legendFormat": "{{label}}"}]
      }
    ]
  }
